                      "pluck",
                      "rim",
                      "sampled:808-clap",
                      "sampled:808-hihat-closed",
                      "sampled:808-hihat-open",
                      "sampled:808-kick",
                      "sampled:808-snare",
                      "sampled:acoustic-crash",
                      "sampled:acoustic-guitar",
                      "sampled:acoustic-hihat-closed",
                      "sampled:acoustic-hihat-open",
                      "sampled:acoustic-kick",
                      "sampled:acoustic-ride",
                      "sampled:acoustic-snare",
                      "sampled:alto-sax",
                      "sampled:brushes-snare",
                      "sampled:clean-guitar",
                      "sampled:finger-bass",
                      "sampled:french-horn",
                      "sampled:hammond-organ",
                      "sampled:kalimba",
                      "sampled:marimba",
                      "sampled:piano",
                      "sampled:slap-bass",
                      "sampled:steel-drums",
                      "sampled:string-section",
                      "sampled:vibraphone",
                      "sampled:vinyl-crackle",
                      "shaker",
                      "snare",
                      "subbass",
                      "synth:acid",
                      "synth:bass",
                      "synth:bell",
                      "synth:brass",
                      "synth:clavinet",
                      "synth:discobass",
                      "synth:dreampop",
                      "synth:epiano",
                      "synth:evolving",
                      "synth:funkbass",
                      "synth:glass",
                      "synth:growl",
                      "synth:hoover",
                      "synth:hypersaw",
                      "synth:jangle",
                      "synth:lead",
                      "synth:organ",
                      "synth:organphase",
                      "synth:pad",
                      "synth:pluck",
                      "synth:reese",
                      "synth:rhodes",
                      "synth:shimmer",
                      "synth:stab",
                      "synth:strings",
                      "synth:sub",
                      "synth:supersaw",
                      "synth:sweep",
                      "synth:vibes",
                      "synth:warmpad",
                      "synth:wobble",
                      "synth:wurlitzer",
                      "tambourine",
                      "tom",
                      "tone:am-bell",
                      "tone:am-tremolo",
                      "tone:duo-lead",
                      "tone:fm-bass",
                      "tone:fm-bell",
                      "tone:fm-epiano",
                      "tone:membrane-kick",
                      "tone:membrane-tom",
                      "tone:metal-cymbal",
                      "tone:metal-hihat",
                      "tone:pluck-string",
                      "woodblock",
                      "zap"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                },
                "required": [
                  "operation",
                  "track_id",
                  "sample_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "const": "set_steps"
                  },
                  "track_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                    "description": "A caller-chosen stable ID. Reuse it when retrying add_track."
                  },
                  "changes": {
                    "minItems": 1,
                    "maxItems": 128,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "step": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 127
                        },
                        "value": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "step",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "operation",
                  "track_id",
                  "changes"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "const": "set_tempo"
                  },
                  "tempo": {
                    "type": "number",
                    "minimum": 60,
                    "maximum": 180
                  }
                },
                "required": [
                  "operation",
                  "tempo"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "session_id",
          "edit"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
