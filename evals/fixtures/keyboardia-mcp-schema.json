                    "const": "set_tempo"
                  },
                  "tempo": {
                    "type": "number",
                    "minimum": 60,
                    "maximum": 180,
                    "description": "Session tempo in beats per minute (60-180)."
                  }
                },
                "required": [
                  "operation",
                  "tempo"
                ],
                "additionalProperties": false
              }
            ]
