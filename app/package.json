{
  "name": "keyboardia",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "description": "Multiplayer step sequencer with polyrhythmic patterns",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:audio-render": "vitest run src/audio/*.render.test.ts",
    "test:unit:watch": "vitest",
    "test:mcp": "vitest run src/worker/mcp-edits.test.ts src/worker/mcp-guard.test.ts src/worker/mcp.test.ts src/worker/mcp-evals.test.ts",
    "test:bench": "vitest bench --run",
    "evals:skill": "node ../evals/run-benchmark.mjs",
    "evals:autonomous": "node scripts/run-autonomous-discovery.mjs",
    "test:integration": "npm run build && npm run test:integration:built",
    "test:integration:built": "cd test/integration && npm test",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:e2e": "npx playwright test",
    "test:e2e:serial": "npx playwright test --workers=1 --project=chromium",
    "test:e2e:smoke": "npx playwright test --project=chromium e2e/track-reorder.spec.ts e2e/plock-editor.spec.ts e2e/pitch-contour-alignment.spec.ts",
    "test:e2e:full": "npx playwright test --project=chromium --project=webkit",
    "test:e2e:mobile": "npx playwright test e2e/mobile-iphone.spec.ts --project=mobile-safari",
    "test:e2e:populated-visual": "USE_MOCK_API=1 npx playwright test e2e/populated-visual.spec.ts --project=chromium",
    "test:e2e:all-local": "npx playwright test --project=chromium && npm run test:e2e:mobile",
    "test:e2e:full-stack": "tsx scripts/test-e2e-full-stack.ts",
    "test:e2e:full-stack:smoke": "tsx scripts/test-e2e-full-stack.ts --smoke",
    "test:e2e:session-contract:worker": "tsx scripts/test-e2e-full-stack.ts --session-contract",
    "test:e2e:collaboration:worker": "tsx scripts/test-e2e-full-stack.ts --collaboration",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "smoke:mcp:staging": "tsx scripts/mcp-smoke.ts https://staging.keyboardia.dev",
    "smoke:mcp:production": "tsx scripts/mcp-smoke.ts https://keyboardia.dev",
    "smoke:skills": "tsx scripts/agent-skills-smoke.ts",
    "smoke:skills:staging": "tsx scripts/agent-skills-smoke.ts https://staging.keyboardia.dev",
    "smoke:skills:production": "tsx scripts/agent-skills-smoke.ts https://keyboardia.dev",
    "validate:e2e-inventories": "node scripts/check-e2e-inventories.mjs",
    "validate:test-quality": "npm run validate:test-antipatterns && npm run validate:test-links && npm run validate:dead-exports && npm run validate:unrun-tests",
    "validate:test-antipatterns": "tsx scripts/check-test-antipatterns.ts",
    "validate:test-links": "tsx scripts/check-test-subject-links.ts",
    "validate:sync": "tsx scripts/validate-sync-checklist.ts",
    "validate:samples": "bash scripts/validate-sample-volume.sh",
    "validate:manifests": "tsx scripts/validate-manifests.ts",
    "validate:release-times": "tsx scripts/validate-release-times.ts",
    "validate:playable-ranges": "tsx scripts/validate-playable-ranges.ts",
    "validate:velocity": "tsx scripts/validate-velocity-layers.ts",
    "validate:sample-quality": "tsx scripts/validate-sample-quality.ts --strict",
    "samples:lab:check": "tsx scripts/sample-lab.ts check",
    "samples:lab:readiness": "tsx scripts/sample-lab.ts readiness",
    "samples:lab:audit": "tsx scripts/sample-lab.ts audit",
    "samples:lab:browser-check": "tsx scripts/sample-lab.ts browser-check",
    "samples:lab:build": "tsx scripts/sample-lab.ts build",
    "samples:sources": "tsx scripts/sample-lab.ts sources",
    "samples:inspect-sfz": "tsx scripts/sample-lab.ts inspect-sfz",
    "samples:import-sfz": "tsx scripts/sample-pipeline-sfz-cli.ts",
    "samples:enrichment:generate": "node --import tsx scripts/generate-complete-sample-enrichment.ts",
    "samples:enrichment:verify": "node --import tsx scripts/promote-complete-sample-enrichment.ts --verify-only",
    "samples:curation:verify": "node --import tsx scripts/promote-complete-sample-enrichment.ts --verify-only",
    "samples:pipeline:baselines": "tsx scripts/sample-pipeline-baseline.ts",
    "samples:pipeline:review": "tsx scripts/sample-pipeline-review-index.ts",
    "samples:pipeline:contract": "RUN_REAL_SAMPLE_PIPELINE=1 vitest run test/sample-pipeline-real-contract.test.ts",
    "validate:all": "tsx scripts/validate-all.ts",
    "check:mcp-bot-protection": "tsx scripts/check-mcp-bot-protection.ts",
    "typecheck:worker": "tsc -b tsconfig.worker.json --pretty false",
    "bundle:worker": "wrangler deploy --dry-run --env= --outdir .wrangler/worker-check",
    "check:worker-bundle": "node scripts/check-worker-bundle.mjs .wrangler/worker-check",
    "check:worker": "npm run typecheck:worker && npm run bundle:worker && npm run check:worker-bundle",
    "analyze:pitch-shift": "tsx scripts/analyze-pitch-shift-quality.ts",
    "audit:range": "vitest run src/audio/instrument-range-simulation.test.ts src/audio/instrument-range-render.test.ts && tsx scripts/instrument-range-report.ts",
    "audit:range:render": "vitest run src/audio/instrument-range-render.test.ts",
    "audit:range:session": "USE_MOCK_API=1 npx playwright test e2e/instrument-range-session.spec.ts --project=chromium",
    "audit:range:full": "npm run audit:range:session && npm run audit:range",
    "generate:instrument-notes": "tsx scripts/generate-instrument-notes.ts",
    "generate:license": "tsx scripts/generate-license-md.ts",
    "validate:acoustic-pitch": "python3 scripts/validate-acoustic-pitch.py",
    "analyze:velocity": "tsx scripts/report-velocity-coverage.ts",
    "samples": "tsx scripts/process-samples.ts",
    "session": "tsx scripts/session-api.ts",
    "dev:multiplayer": "tsx scripts/dev-multiplayer.ts",
    "analyze:bugs": "tsx scripts/analyze-bug-patterns.ts",
    "analyze:bugs:v2": "tsx scripts/analyze-bug-patterns-v2.ts",
    "analyze:logs": "tsx scripts/analyze-logs.ts",
    "post-fix": "tsx scripts/post-fix-analysis.ts",
    "bug:capture": "tsx scripts/bug-capture.ts --interactive",
    "prepare": "cd .. && husky app/.husky",
    "deploy": "npm run test:mcp && npm run build && wrangler deploy --env staging && npm run smoke:skills:staging && npm run smoke:mcp:staging",
    "deploy:production": "tsx scripts/deploy-production.ts",
    "test:mutation": "stryker run",
    "validate:dead-exports": "tsx scripts/check-dead-exports.ts",
    "validate:unrun-tests": "tsx scripts/check-unrun-tests.ts",
    "typecheck": "tsc -b"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "1.25.0",
    "midi-writer-js": "^3.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tone": "^15.1.22",
    "workers-og": "^0.0.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260629.1",
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.57.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "~8.18.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.5.3",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "midi-file": "^1.2.4",
    "node-web-audio-api": "^2.0.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.15",
    "wrangler": "^4.53.0",
    "ws": "^8.21.1"
  }
}
