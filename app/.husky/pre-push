#!/bin/sh

# Pre-push hook: T0 plus focused T1 by default.
# Phase 1: Unit tests
# Phase 2: Owned offline renders plus dev-only PCM/audio evidence
# Phase 3: Real-Worker desktop smoke
# Phase 4: Mobile Safari contract
#
# Set KEYBOARDIA_VERIFY_T2=1 to append the complete Chromium and WebKit
# functional matrices. CI runs those broad contracts nightly, so ordinary
# pushes do not repeatedly pay their cost.
#
# The full-stack runner owns its Wrangler process. This keeps the backend
# lifecycle deterministic and applies the local-only session-create allowance
# required by a suite that deliberately creates more sessions per minute than
# a person. Production retains the conservative rate limit.
#
# ─── Pipe-inheritance guard ────────────────────────────────────────────
# When git is invoked under a pipe (CI runners, tmux captures, tool
# harnesses like Claude Code) rather than a real terminal, the push will
# hang indefinitely if any process spawned by this hook outlives the hook
# while still holding git's stdout/stderr pipe open. Playwright's browser
# helpers are the likely culprit — they frequently get reparented to PID 1
# after their npm ancestor exits. Git blocks waiting for EOF on its pipe;
# the orphan never closes it.
#
# Detection: `[ -t 1 ]` returns false only when fd1 is not a terminal, i.e.
# git is being piped. In that case we redirect everything to a log file
# BEFORE spawning tests, so orphans inherit a log-file fd, not git's pipe.
# Contents are dumped to /dev/tty at exit when one is available, giving
# the user the same visibility they'd get in an interactive shell.
#
# See docs/LESSONS-LEARNED.md lesson on "pre-push hook pipe-inheritance".
if [ ! -t 1 ] || [ ! -t 2 ]; then
    # Fixed path so failures can always be inspected with `cat <path>`;
    # a per-run mktemp would be cleaner but its name is lost to git's
    # swallowed stderr, making post-mortem awkward.
    PREPUSH_LOG=/tmp/keyboardia-last-prepush.log
    rm -f "$PREPUSH_LOG"
    exec </dev/null >"$PREPUSH_LOG" 2>&1
    # The tty guard must attempt a real open: `[ -w /dev/tty ]` only checks
    # permission bits and passes in containers where /dev/tty exists but
    # opening it fails with ENXIO ("No such device or address"). That failed
    # redirect then aborts the EXIT trap under `set -e` and fails the whole
    # hook AFTER all tests passed. The subshell `( : > /dev/tty )` probes an
    # actual open without that risk.
    trap 'if ( : > /dev/tty ) 2>/dev/null; then cat "$PREPUSH_LOG" > /dev/tty || :; fi' EXIT
fi

set -e

cd app

echo ""
echo "========================================"
echo "  PRE-PUSH: Test Suite"
echo "========================================"
echo ""

# Phase 0: Manifest Validation (instant, catches silent failure bugs)
echo "----------------------------------------"
echo "Phase 0: Manifest Validation"
echo "----------------------------------------"
echo ""

if npx tsx scripts/validate-manifests.ts; then
    echo ""
    echo "✅ All manifests valid!"
    echo ""
else
    echo ""
    echo "❌ Manifest validation FAILED"
    echo ""
    echo "Fix the issues above before pushing."
    echo "Instruments with invalid manifests will be SILENT."
    echo "To skip: git push --no-verify"
    echo ""
    exit 1
fi

# Fail before launching browsers if a spec, backend ownership entry, or exact
# disposition contract has drifted. This also checks that CI and optional local
# T2 runs still own the same complete matrices.
npm run validate:e2e-inventories

# Phase 1: Unit Tests (runs first, no backend required)
echo "----------------------------------------"
echo "Phase 1: Unit Tests (~11s)"
echo "----------------------------------------"
echo ""

UNIT_START=$(date +%s)

if npm run test:unit; then
    UNIT_END=$(date +%s)
    UNIT_DURATION=$((UNIT_END - UNIT_START))
    echo ""
    echo "✅ Unit tests passed! (${UNIT_DURATION}s)"
    echo ""
else
    echo ""
    echo "❌ Unit tests FAILED"
    echo ""
    echo "Fix the issues above before pushing."
    echo "To skip: git push --no-verify"
    echo ""
    exit 1
fi

# Phase 2: Owned offline renders plus dev-only PCM/audio evidence
echo "----------------------------------------"
echo "Phase 2: Offline Renders + PCM Capture"
echo "----------------------------------------"
echo ""

PCM_START=$(date +%s)

# Native OfflineAudioContext tests have dedicated ownership rather than running
# under the broadly parallel unit collector. Run each owner before launching
# the browser capture contract.
#
# The synchronized PCM taps are deliberately omitted from production Worker
# bundles. The real-backend lanes therefore skip this file, so run its complete
# six-test contract against the mock/Vite build instead of leaving it CI-only.
if npm run test:audio-render && npm run test:envelope:pcm && USE_MOCK_API=1 E2E_FUNCTIONAL_ONLY=1 CI=true E2E_PORT=5176 PLAYWRIGHT_JSON_OUTPUT_FILE=test-results/prepush-pcm.json npx playwright test e2e/capture-session.spec.ts --project=chromium --workers=1 --retries=0 && node scripts/assert-playwright-stats.mjs test-results/prepush-pcm.json 6 0; then
    PCM_END=$(date +%s)
    PCM_DURATION=$((PCM_END - PCM_START))
    echo ""
    echo "✅ Offline render and PCM capture tests passed! (${PCM_DURATION}s)"
    echo ""
else
    echo ""
    echo "❌ Offline render or PCM capture tests FAILED"
    echo ""
    echo "An owned render lane, dev-only audio evidence, or its exact inventory failed."
    echo "Fix the issue before pushing."
    echo "To skip: git push --no-verify"
    echo ""
    exit 1
fi

# Phase 3: Real-Worker desktop smoke
echo "----------------------------------------"
echo "Phase 3: Real-Worker Smoke (Chromium)"
echo "----------------------------------------"
echo ""

SMOKE_START=$(date +%s)

# Screenshot contracts have runner-specific baselines and a dedicated CI lane;
# the functional gate must not generate or bless developer-machine snapshots.
if E2E_FUNCTIONAL_ONLY=1 E2E_WORKER_PORT=8791 PLAYWRIGHT_JSON_OUTPUT_FILE=test-results/prepush-smoke.json npm run test:e2e:full-stack:smoke && node scripts/assert-playwright-stats.mjs test-results/prepush-smoke.json 15 0; then
    SMOKE_END=$(date +%s)
    SMOKE_DURATION=$((SMOKE_END - SMOKE_START))
    echo ""
    echo "✅ Real-Worker smoke passed! (${SMOKE_DURATION}s)"
    echo ""
else
    echo ""
    echo "❌ Real-Worker smoke FAILED"
    echo ""
    echo "Some focused Chromium functional or real-audio tests failed."
    echo "Review the failures above."
    echo "Fix the issues above before pushing."
    echo "To skip: git push --no-verify"
    echo ""
    exit 1
fi

# Phase 4: Mobile Safari Test (iPhone viewport + touch interactions)
echo "----------------------------------------"
echo "Phase 4: Mobile Safari (iPhone)"
echo "----------------------------------------"
echo ""

MOBILE_START=$(date +%s)

if PLAYWRIGHT_JSON_OUTPUT_FILE=test-results/prepush-mobile-safari.json E2E_WORKER_PORT=8792 npm run test:e2e:full-stack -- e2e/mobile-iphone.spec.ts --project=mobile-safari && node scripts/assert-playwright-stats.mjs test-results/prepush-mobile-safari.json 7 0; then
    MOBILE_END=$(date +%s)
    MOBILE_DURATION=$((MOBILE_END - MOBILE_START))
    echo ""
    echo "✅ Mobile Safari test passed! (${MOBILE_DURATION}s)"
    echo ""
else
    echo ""
    echo "❌ Mobile Safari test FAILED"
    echo ""
    echo "Mobile-specific tests failed."
    echo "Review the failures above."
    echo "To skip: git push --no-verify"
    exit 1
fi

T2_DURATION=0
if [ "${KEYBOARDIA_VERIFY_T2:-0}" = "1" ]; then
    echo "----------------------------------------"
    echo "Phase 5: T2 Full Chromium Matrix"
    echo "----------------------------------------"
    echo ""

    FULL_START=$(date +%s)
    if E2E_FUNCTIONAL_ONLY=1 E2E_WORKER_PORT=8794 PLAYWRIGHT_JSON_OUTPUT_FILE=test-results/prepush-chromium.json npm run test:e2e:full-stack -- --project=chromium --workers=2 && node scripts/assert-playwright-stats.mjs test-results/prepush-chromium.json 210 33; then
        FULL_END=$(date +%s)
        FULL_DURATION=$((FULL_END - FULL_START))
    else
        echo "❌ T2 Chromium matrix FAILED"
        exit 1
    fi

    echo "----------------------------------------"
    echo "Phase 6: T2 Full WebKit Matrix"
    echo "----------------------------------------"
    echo ""

    WEBKIT_START=$(date +%s)
    if E2E_FUNCTIONAL_ONLY=1 E2E_WORKER_PORT=8793 PLAYWRIGHT_JSON_OUTPUT_FILE=test-results/prepush-webkit.json npm run test:e2e:full-stack -- --project=webkit --no-deps --workers=1 && node scripts/assert-playwright-stats.mjs test-results/prepush-webkit.json 163 63; then
        WEBKIT_END=$(date +%s)
        WEBKIT_DURATION=$((WEBKIT_END - WEBKIT_START))
        T2_DURATION=$((FULL_DURATION + WEBKIT_DURATION))
    else
        echo "❌ T2 WebKit matrix FAILED"
        exit 1
    fi

    echo ""
    echo "✅ T2 browser matrices passed! (${T2_DURATION}s)"
    echo ""
else
    echo "ℹ️  Broad Chromium/WebKit matrices are deferred to nightly T2."
    echo "   Run locally with KEYBOARDIA_VERIFY_T2=1 git push."
    echo ""
fi

TOTAL_DURATION=$((UNIT_DURATION + PCM_DURATION + SMOKE_DURATION + MOBILE_DURATION + T2_DURATION))

echo "========================================"
echo "  ✅ All tests passed! (${TOTAL_DURATION}s)"
echo "  Pushing to remote..."
echo "========================================"
echo ""
