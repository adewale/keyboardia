{
  /*
   * Type-checked scripts.
   *
   * `scripts/` is not covered by tsconfig.app.json, so a script can accumulate
   * type errors while `npm run lint` stays green — and mcp-smoke.ts is the
   * deployment gate, so it would fail at the exact moment someone runs it to
   * verify a deploy. This project is referenced from tsconfig.json, so `tsc -b`
   * (and therefore `npm run build` and CI's Build job) checks it.
   *
   * The include list is deliberately explicit rather than `scripts`: most of
   * the directory predates any type checking and does not compile clean. Add
   * files here as they are made to pass, not in bulk.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    /* vite/client because scripts reach into src/, which reads import.meta.env. */
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* scripts/test-og-image.ts imports src/worker/og-image.tsx. */
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /*
   * src/types carries ambient declarations (File System Access, worklet URLs)
   * that tsconfig.app.json picks up via its own `include`. Scripts that import
   * src/ need them too, and an ambient .d.ts only applies to a project that
   * includes it.
   */
  "include": ["scripts", "src/types"],
  /*
   * scripts/test-og-image.ts imports src/worker/og-image.tsx, and worker code
   * needs the Cloudflare Workers runtime types (Fetcher, ExecutionContext,
   * DurableObjectNamespace, caches.default). Those live in
   * @cloudflare/workers-types, which is currently a dependency of
   * test/integration only, and src/worker is excluded from tsconfig.app.json —
   * so no project in `tsc -b` type-checks the worker at all. Giving the worker
   * its own project is worth doing and is not this change.
   */
  "exclude": ["scripts/test-og-image.ts"]
}
